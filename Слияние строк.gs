/**
 * Вариант Б: одна строка «База» = одно конкретное применение компонента
 * у одного непосредственного родителя и одного root_uuid.
 *
 * Поэтому прежнее автоматическое слияние одинаковых item_name отключено:
 * оно уничтожало контекст parent_uuid/root_uuid и превращало отношение в many-to-many.
 * Агрегированную потребность по одинаковым изделиям следует строить отдельным
 * представлением/отчётом, не изменяя первичные строки «База».
 *
 * Функция сохранена как compatibility no-op, чтобы существующие вызовы после
 * развёртывания спецификации не требовали отдельной миграции.
 */
function checkAndMergeDuplicates(baseSheet, columnCount) {
  if (!baseSheet) return { merged: 0, skipped: true };
  Logger.log('checkAndMergeDuplicates: автоматическое слияние отключено архитектурой Variant B.');
  return { merged: 0, skipped: true };
}
